{
  admin off
}
{$COOLPROOF_API_DOMAIN} {
  encode zstd gzip
  log {
    output stdout
    format json
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }
  handle /api/* {
    reverse_proxy api:8000
  }
  handle /health/* {
    reverse_proxy api:8000
  }
  handle /docs* {
    reverse_proxy api:8000
  }
  handle /redoc* {
    reverse_proxy api:8000
  }
  handle /openapi.json {
    reverse_proxy api:8000
  }
  handle /metrics {
    reverse_proxy api:8000
  }
  handle {
    root * /srv/frontend
    try_files {path} /index.html
    file_server
  }
}
